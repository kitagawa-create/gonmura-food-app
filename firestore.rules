rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validTableNumber(n) {
      return (n is int && n >= 1 && n <= 50)
          || (n is string && n.matches('^([1-9]|[1-4][0-9]|50)$'));
    }

    function validCategoryName(s) {
      return s is string && s.size() >= 1 && s.size() <= 20;
    }

    function validMenuName(s) {
      return s is string && s.size() >= 1 && s.size() <= 30;
    }

    function validDescription(s) {
      return s is string && s.size() <= 200;
    }

    function validNote(s) {
      return s is string && s.size() <= 100;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner()
        && validCategoryName(request.resource.data.name);
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create: if isOwner()
        && validMenuName(request.resource.data.name)
        && validDescription(request.resource.data.description);
      allow delete: if isOwner();
      allow update: if (isOwner()
            && validMenuName(request.resource.data.name)
            && validDescription(request.resource.data.description))
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["isAvailable", "isSoldOut", "updatedAt"]));
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['tableNumber'])
                    && validTableNumber(request.resource.data.tableNumber)
                    && (!('customerNote' in request.resource.data)
                        || validNote(request.resource.data.customerNote));
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
