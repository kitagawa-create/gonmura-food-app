rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validTableNumber(n) {
      return n is string && n.size() >= 1 && n.size() <= 10;
    }

    function validCategoryName(s) {
      return s is string && s.size() >= 1 && s.size() <= 20;
    }

    function validMenuName(s) {
      return s is string && s.size() >= 1 && s.size() <= 30;
    }

    function validDescription(s) {
      return s is string && s.size() <= 200;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner()
        && validCategoryName(request.resource.data.name);
      allow delete: if isOwner();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create: if isOwner()
        && validMenuName(request.resource.data.name)
        && validDescription(request.resource.data.description);
      allow delete: if isOwner();
      allow update: if (isOwner()
            && validMenuName(request.resource.data.name)
            && validDescription(request.resource.data.description))
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["status", "updatedAt"]));
    }

    // collectionGroup("orders") クエリに必要なワイルドカードルール
    match /{path=**}/orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
            && request.resource.data.status == "paid"
            && (resource.data.status == "pending" || resource.data.status == "completed"));
      allow delete: if isStaff();
    }

    // collectionGroup("items") クエリに必要なワイルドカードルール
    match /{path=**}/items/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /customers/{customerId} {
      allow create: if true;
      allow read: if true;
      allow update: if isStaff()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tableId']);
      allow delete: if isStaff();

      match /orders/{orderId} {
        allow create: if true;
        allow read: if true;
        allow update: if isStaff()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
              && request.resource.data.status == "paid"
              && (resource.data.status == "pending" || resource.data.status == "completed"));
        allow delete: if isStaff();

        match /items/{itemId} {
          allow read: if true;
          allow create: if true;
          allow update: if isStaff();
          allow delete: if isStaff();
        }
      }
    }

    match /tables/{tableId} {
      allow create: if isStaff() && validTableNumber(request.resource.data.tableNumber);
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isOwner();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
