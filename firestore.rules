rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validTableNumber(n) {
      return (n is int && n >= 1 && n <= 30)
          || (n is string && n.matches('^([1-9]|[12][0-9]|30)$'));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["isAvailable", "isSoldOut", "updatedAt"]));
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['tableNumber'])
                    && validTableNumber(request.resource.data.tableNumber);
      allow read: if true;
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // tables: 誰でも読める（顧客側プルダウン用）
    // guestCount/sessionStartedAt は顧客側（未認証）から更新するため update を全員許可
    // create/delete は owner のみ
    match /tables/{tableId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isStaff() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["guestCount", "sessionStartedAt"])
      );
    }
  }
}
